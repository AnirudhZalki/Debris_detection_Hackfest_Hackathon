# Copy to .env and fill in what you have. Everything is optional.

# Space-Track.org (free account) -> real CDMs (cdm_public) + 60-day TLE history for anomaly/propagation KPIs
SPACETRACK_USER=
SPACETRACK_PASS=

# ESA DISCOSweb API token (free) -> mass and cross-section for drag / casualty estimates
DISCOS_TOKEN=

# auto | live | offline
SDRP_DATA_MODE=live
# objects to screen (laptop-friendly default)
SDRP_MAX_OBJECTS=3000
SDRP_HORIZON_H=24
SDRP_STEP_S=20
SDRP_THRESHOLD_KM=10
# GPU screening via CuPy: auto | on | off
SDRP_USE_GPU=auto
